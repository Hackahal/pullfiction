{
  "name": "pullfiction-sharing-local",
  "main": "cloudflare/share-worker.mjs",
  "compatibility_date": "2026-10-27",
  "vars": {
    "SHARE_ORIGIN": "http://localhost:8787",
    "SHARE_SITE_KEY": "1x00000000000000000000AA"
  },
  "d1_databases": [{
    "binding": "SHARES",
    "database_name": "pullfiction-shares-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "cloudflare/migrations"
  }],
  "ratelimits": [
    { "name": "SHARE_READ_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "SHARE_WRITE_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ]
}
